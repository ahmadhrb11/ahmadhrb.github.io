# ---------------------------------------------------------------
#  متغيّرات البيئة — انسخ هذا الملف إلى .env وعدّل القيم
# ---------------------------------------------------------------

# قاعدة البيانات المحلية (SQLite) — تُستخدم عند التطوير
DATABASE_URL="file:./dev.db"

# مفتاح توقيع جلسات NextAuth (إلزامي)
# لتوليد مفتاح: openssl rand -base64 32
AUTH_SECRET="ضع-هنا-مفتاحا-عشوائيا-طويلا-جدا"

# رابط الموقع (اتركه فارغًا محليًا، وضع رابط Vercel في الإنتاج)
# AUTH_URL="https://your-app.vercel.app"

# عدد الأيام قبل التصعيد التلقائي لوكيل التدريب (الافتراضي 3)
ESCALATION_DAYS="3"

# مفتاح حماية مسار المهمة المجدولة /api/cron/escalate
# لتوليد مفتاح: openssl rand -hex 32
CRON_SECRET="ضع-هنا-مفتاحا-عشوائيا"

# ---------------------------------------------------------------
#  الإشعارات البريدية عبر Power Automate
# ---------------------------------------------------------------

# رابط الـ webhook الموحّد لجميع الأدوار.
# يُنسخ من خطوة "When an HTTP request is received" بعد حفظ الـ Flow في Power Automate.
# الرابط يحمل توقيع وصول (sig=) بداخله فعامله كسرّ ولا تضعه في الكود.
# اتركه فارغًا لتعطيل الإشعارات تمامًا — يعمل النظام كالمعتاد مع تحذير واحد في السجل.
POWER_AUTOMATE_WEBHOOK_URL=

# عنوان الموقع المستخدم لبناء روابط الطلبات داخل الإيميلات.
# اختياري: إن تُرك فارغًا يُستخدم AUTH_URL، وإن لم يوجد فـ http://localhost:3000
# APP_BASE_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------
#  الإنتاج على Vercel + Turso (اتركها فارغة محليًا)
#  عند وجود هاتين القيمتين يتحوّل التطبيق تلقائيًا لاستخدام Turso
# ---------------------------------------------------------------
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="ey..."
