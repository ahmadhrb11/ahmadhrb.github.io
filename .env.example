# ---------------------------------------------------------------
#  متغيّرات البيئة — انسخ هذا الملف إلى .env وعدّل القيم
# ---------------------------------------------------------------

# قاعدة البيانات المحلية (SQLite) — تُستخدم عند التطوير
DATABASE_URL="file:./dev.db"

# مفتاح توقيع جلسات NextAuth (إلزامي)
# لتوليد مفتاح: openssl rand -base64 32
AUTH_SECRET="ضع-هنا-مفتاحا-عشوائيا-طويلا-جدا"

# رابط الموقع (اتركه فارغًا محليًا، وضع رابط Vercel في الإنتاج)
# AUTH_URL="https://your-app.vercel.app"

# عدد الأيام قبل التصعيد التلقائي لوكيل التدريب (الافتراضي 3)
ESCALATION_DAYS="3"

# مفتاح حماية مسار المهمة المجدولة /api/cron/escalate
# لتوليد مفتاح: openssl rand -hex 32
CRON_SECRET="ضع-هنا-مفتاحا-عشوائيا"

# ---------------------------------------------------------------
#  الإشعارات البريدية — Resend + Power Automate Relay
# ---------------------------------------------------------------
# السلسلة: الكود يرسل عبر Resend إيميل «حاوية» إلى صندوق مؤسسي مراقَب،
# ثم Power Automate يحلّل متنه ويرسل الإيميل الرسمي للمستلم الحقيقي.

# مفتاح Resend API — من https://resend.com/api-keys (مجاني، بلا حساب مايكروسوفت).
# اتركه فارغًا لتعطيل الإشعارات تمامًا — يعمل النظام كالمعتاد مع تحذير في السجل.
RESEND_API_KEY=

# عنوان المرسِل. نطاق Resend التجريبي مؤقتًا لحين توثيق نطاق الكلية في Resend.
# تنبيه: مع هذا المرسِل قد يقصر Resend الإرسال على بريد صاحب الحساب نفسه —
# راجع قسم README قبل الاعتماد عليه في الإنتاج.
RESEND_FROM_EMAIL=onboarding@resend.dev

# صندوق البريد المؤسسي الذي يراقبه Power Automate — وجهة كل الإيميلات الحاوية.
# مثال: notifications@tvtc.edu.sa
NOTIFICATIONS_RELAY_EMAIL=

# عنوان الموقع المستخدم لبناء روابط الطلبات داخل الإشعارات.
# اختياري: إن تُرك فارغًا يُستخدم AUTH_URL، وإن لم يوجد فـ http://localhost:3000
# APP_BASE_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------
#  الإنتاج على Vercel + Turso (اتركها فارغة محليًا)
#  عند وجود هاتين القيمتين يتحوّل التطبيق تلقائيًا لاستخدام Turso
# ---------------------------------------------------------------
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="ey..."
